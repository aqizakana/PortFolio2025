{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"incremental": true,
		"module": "esnext",
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./app/*"],
			"@components/*": ["./app/components/*"],
			"@mesh/*": ["./app/components/mesh/*"],
			"@shaders/*": ["./app/shaders/*"],
			"@hooks/*": ["./app/hooks/*"],
			"@utils/*": ["./app/utils/*"],
			"@config/*": ["./app/config/*"],
			"@styles/*": ["./app/styles/*"]
		},
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": ["next-env.d.ts", ".next/types/**/*.ts", "**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules"]
}
